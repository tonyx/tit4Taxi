@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode InteractiveAuto

<PageTitle>@Loc["AuthTitle"]</PageTitle>

<h1>@Loc["AuthenticatedHeader"]</h1>

<AuthorizeView>
    @string.Format(Loc["HelloUserFormat"], context.User.Identity?.Name)
</AuthorizeView>
