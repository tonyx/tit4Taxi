@page "/TaxiDriverMini"
@attribute [Authorize]
@using TitForTat.Services
@using TitForTat.Shared.Services
@using static TitForTat.Shared.Commons
@using static TitForTat.Domain.Coop
@using static TitForTat.Domain.Ledger
@using static TitForTat.Domain.User
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TitForTat.Shared
@using System.Linq
@using System.Text.Json
@inject ICoopService CoopService
@inject ILedgerService LedgerService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>@Loc["QuickSpend"]</PageTitle>

<div class="container d-flex flex-column align-items-center justify-content-center min-vh-100 py-4" style="max-width: 500px;">
    <!-- Main Card -->
    <div class="card border-0 shadow-lg w-100 p-4 text-center" style="border-radius: 24px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
        
        <!-- Header -->
        <div class="mb-4">
            <div class="d-inline-flex bg-warning text-dark p-3 rounded-circle shadow-sm mb-3">
                <i class="bi bi-lightning-fill fs-3"></i>
            </div>
            <h3 class="fw-bold text-dark">@Loc["QuickSpendPortal"]</h3>
            <p class="text-muted small">@Loc["SimplifiedMobileLogging"]</p>
        </div>

        <!-- Feedback Messages -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger shadow-sm small" role="alert" style="border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success shadow-sm small" role="alert" style="border-radius: 12px;">
                <i class="bi bi-check-circle-fill me-1"></i> @successMessage
            </div>
        }

        @if (isLoading)
        {
            <div class="py-5">
                <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">@Loc["Loading"]</span>
                </div>
                <p class="mt-3 text-muted small">@Loc["LocatingCoopAndActiveLedger"]</p>
            </div>
        }
        else if (userCoop == null)
        {
            <div class="py-4 text-danger">
                <i class="bi bi-building-exclamation fs-1 mb-2"></i>
                <h5 class="fw-bold">@Loc["NoCooperativeAffiliation"]</h5>
                <p class="text-muted small px-3">@Loc["NoCooperativeAffiliationDescription"]</p>
                <a href="/TaxiDriver" class="btn btn-outline-secondary btn-sm mt-3 px-4" style="border-radius: 10px;">@Loc["GoToPortal"]</a>
            </div>
        }
        else if (targetLedger == null)
        {
            <div class="py-4 text-secondary">
                <i class="bi bi-journal-x fs-1 mb-2"></i>
                <h5 class="fw-bold">@Loc["NoActiveLedgers"]</h5>
                <p class="text-muted small px-3">@string.Format(Loc["NoActiveLedgersConfiguredForCoopFormat"].Value, userCoop.Name)</p>
            </div>
        }
        else
        {
            <!-- Info block -->
            <div class="bg-light p-3 rounded-4 mb-4 text-start shadow-sm">
                <div class="mb-2">
                    <span class="text-secondary small fw-semibold d-block">@Loc["YourCooperative"]</span>
                    <span class="fw-bold text-dark">@userCoop.Name</span>
                </div>
                <div class="mb-2">
                    <span class="text-secondary small fw-semibold d-block">@Loc["OppositeCooperative"]</span>
                    <span class="fw-bold text-primary">@(otherCoop?.Name ?? Loc["Loading"].Value)</span>
                </div>
                @if (userLat.HasValue && userLng.HasValue)
                {
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                        <span class="text-muted small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@Loc["LocationAcquired"]</span>
                        <button class="btn btn-sm btn-link text-warning p-0 text-decoration-none small" @onclick="RefreshLocation"><i class="bi bi-arrow-clockwise me-1"></i>@Loc["Refresh"]</button>
                    </div>
                }
                else
                {
                    <div class="text-danger small mt-2 pt-2 border-top">
                        <i class="bi bi-geo-fill me-1"></i> @Loc["GeolocationUnavailableDescription"]
                    </div>
                }
            </div>

            <!-- Huge Action Button -->
            <div class="my-4">
                @if (pendingSpendCts != null)
                {
                    <button class="btn btn-warning w-100 shadow-lg py-4 fw-bold fs-3 text-uppercase" style="border-radius: 20px; min-height: 140px;" @onclick="CancelSpend">
                        <i class="bi bi-x-circle-fill d-block fs-1 mb-2"></i>
                        @Loc["Undo"] (@countdownSeconds)
                    </button>
                    <div class="text-warning small mt-2 fw-semibold">
                        <i class="bi bi-hourglass-split me-1"></i> Spending in @countdownSeconds seconds...
                    </div>
                }
                else
                {
                    @if (isCloserToOpposite)
                    {
                        <button class="btn btn-success w-100 shadow-lg py-4 fw-bold fs-3 text-uppercase pulse-animation" style="border-radius: 20px; min-height: 140px;" @onclick="InitiateSpend">
                            <i class="bi bi-check-circle-fill d-block fs-1 mb-2"></i>
                            @Loc["SpendToken"]
                        </button>
                        <div class="text-success small mt-2 fw-semibold">
                            <i class="bi bi-shield-check me-1"></i> @Loc["GeolocationVerifiedZone"]
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-danger w-100 shadow-lg py-4 fw-bold fs-3 text-uppercase" style="border-radius: 20px; min-height: 140px;" @onclick="InitiateSpend">
                            <i class="bi bi-exclamation-triangle-fill d-block fs-1 mb-2"></i>
                            @Loc["SpendToken"]
                        </button>
                        <div class="text-danger small mt-2 fw-semibold">
                            <i class="bi bi-shield-exclamation me-1"></i> @Loc["GeolocationWarningZone"]
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

<style>
    .pulse-animation {
        box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7);
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% {
            transform: scale(1);
        }
        70% {
            transform: scale(1.02);
            box-shadow: 0 0 0 15px rgba(25, 135, 84, 0);
        }
        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(25, 135, 84, 0);
        }
    }
</style>

@code {
    private System.Threading.CancellationTokenSource? pendingSpendCts;
    private int countdownSeconds = 0;

    public class CoopTrackingRecord
    {
        public string CoopId { get; set; } = string.Empty;
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public bool TokenSpendWithoutExiting { get; set; }
    }

    private List<CoopTrackingRecord> trackingRecords = new();

    private async Task InitiateSpend()
    {
        if (pendingSpendCts != null) return;

        // Perform the tokenSpendWithoutExiting double-spend check
        if (userLat.HasValue && userLng.HasValue && trackingRecords.Any())
        {
            CoopTrackingRecord? closestRecord = null;
            double minDistance = double.MaxValue;
            foreach (var record in trackingRecords)
            {
                double dist = CalculateDistance(userLat.Value, userLng.Value, record.Latitude, record.Longitude);
                if (dist < minDistance)
                {
                    minDistance = dist;
                    closestRecord = record;
                }
            }

            if (closestRecord != null && closestRecord.TokenSpendWithoutExiting)
            {
                var warningText = "It looks like you are attempting to spend a token in a territory where you have already spent a token without exiting. Spending twice here could be due to an error. Are you sure you want to proceed?";
                var confirmOverride = await JSRuntime.InvokeAsync<bool>("confirm", warningText);
                if (!confirmOverride) return;
            }
        }
        else if (!isCloserToOpposite)
        {
            var warningText = Loc["GeolocationOverrideWarning"].Value;
            var confirmOverride = await JSRuntime.InvokeAsync<bool>("confirm", warningText);
            if (!confirmOverride) return;
        }

        pendingSpendCts = new System.Threading.CancellationTokenSource();
        countdownSeconds = 5;

        try
        {
            while (countdownSeconds > 0)
            {
                await Task.Delay(1000, pendingSpendCts.Token);
                countdownSeconds--;
                StateHasChanged();
            }
            
            pendingSpendCts = null;
            await ExecuteSpend(skipWarning: true);
        }
        catch (TaskCanceledException)
        {
            pendingSpendCts = null;
            successMessage = "Action undone successfully.";
            StateHasChanged();
        }
    }

    private void CancelSpend()
    {
        pendingSpendCts?.Cancel();
    }

    private bool isLoading = true;
    private Coop? userCoop;
    private TitForTat.Domain.Ledger.Ledger? targetLedger;
    private Coop? otherCoop;
    private bool isCloserToOpposite = false;
    private double? userLat;
    private double? userLng;
    private string? errorMessage;
    private string? successMessage;
    private UserContext? userContext;
    private UserId currentUserId = UserId.New();
    private bool locationInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!locationInitialized && userCoop != null && targetLedger != null && userContext != null)
        {
            locationInitialized = true;
            
            var coopsWithCoordsResult = await CoopService.GetCoopsThatHaveCoordinatesDefined(userContext, CancellationToken.None);
            if (coopsWithCoordsResult.IsOk)
            {
                var coopsWithCoords = coopsWithCoordsResult.ResultValue.ToList();
                await ReconcileTrackingRecords(coopsWithCoords);
            }

            await RefreshLocation();
        }
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            userContext = ConverterUtils.fromClaimsPrincipal(authState.User);

            if (userContext == null || userContext.IsAnonymous)
            {
                errorMessage = Loc["MustBeLoggedIn"];
                isLoading = false;
                return;
            }

            if (userContext is UserContext.Authenticated authenticated)
            {
                currentUserId = authenticated.UserId;
            }

            // Load cooperatives
            var coopsResult = await CoopService.GetAllCoops(userContext, CancellationToken.None);
            if (coopsResult.IsOk)
            {
                var allCoops = coopsResult.ResultValue.ToList();
                userCoop = allCoops.FirstOrDefault(c => c.IsMember(currentUserId) || c.IsManager(currentUserId));
            }
            else
            {
                errorMessage = $"{Loc["FailedToLoadCooperativesPrefix"]}{coopsResult.ErrorValue}";
                isLoading = false;
                return;
            }

            if (userCoop != null)
            {
                // Load first active ledger involving the user's coop
                var ledgersResult = await LedgerService.GetActiveLedgers(userContext, CancellationToken.None);
                if (ledgersResult.IsOk)
                {
                    targetLedger = ledgersResult.ResultValue
                        .FirstOrDefault(l => l.Coops.Item1.Value == userCoop.CoopId.Value || l.Coops.Item2.Value == userCoop.CoopId.Value);

                    if (targetLedger != null)
                    {
                        var isCoop1 = targetLedger.Coops.Item1.Value == userCoop.CoopId.Value;
                        var otherCoopId = isCoop1 ? targetLedger.Coops.Item2 : targetLedger.Coops.Item1;
                        var otherCoopResult = await CoopService.GetCoop(userContext, otherCoopId, CancellationToken.None);
                        if (otherCoopResult.IsOk)
                        {
                            otherCoop = otherCoopResult.ResultValue;
                        }
                    }
                }
                else
                {
                    errorMessage = $"{Loc["FailedToLoadLedgersPrefix"]}{ledgersResult.ErrorValue}";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{Loc["ErrorLoadingDashboardPrefix"]}{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ReconcileTrackingRecords(List<Coop> coopsWithCoords)
    {
        try
        {
            var localDataJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "titfortat_coops_tracking");
            List<CoopTrackingRecord>? localRecords = null;
            if (!string.IsNullOrEmpty(localDataJson))
            {
                localRecords = JsonSerializer.Deserialize<List<CoopTrackingRecord>>(localDataJson);
            }
            
            var reconciled = new List<CoopTrackingRecord>();
            foreach (var coop in coopsWithCoords)
            {
                if (coop.CenterCoordinate != null && Microsoft.FSharp.Core.OptionModule.IsSome(coop.CenterCoordinate))
                {
                    var coord = coop.CenterCoordinate.Value;
                    var localMatch = localRecords?.FirstOrDefault(r => r.CoopId == coop.CoopId.Value.ToString());
                    reconciled.Add(new CoopTrackingRecord
                    {
                        CoopId = coop.CoopId.Value.ToString(),
                        Latitude = coord.Latitude,
                        Longitude = coord.Longitude,
                        TokenSpendWithoutExiting = localMatch?.TokenSpendWithoutExiting ?? false
                    });
                }
            }
            trackingRecords = reconciled;
            await SaveTrackingRecords();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reconciling tracking records: {ex.Message}");
        }
    }

    private async Task SaveTrackingRecords()
    {
        try
        {
            var json = JsonSerializer.Serialize(trackingRecords);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "titfortat_coops_tracking", json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving tracking records: {ex.Message}");
        }
    }

    private void EvaluateGeofence(double lat, double lng)
    {
        if (trackingRecords == null || !trackingRecords.Any()) return;

        var activeSpends = trackingRecords.Where(r => r.TokenSpendWithoutExiting).ToList();
        if (!activeSpends.Any()) return;

        CoopTrackingRecord? closestRecord = null;
        double minDistance = double.MaxValue;
        foreach (var record in trackingRecords)
        {
            double dist = CalculateDistance(lat, lng, record.Latitude, record.Longitude);
            if (dist < minDistance)
            {
                minDistance = dist;
                closestRecord = record;
            }
        }

        if (closestRecord != null)
        {
            var isCloserToDifferent = !activeSpends.Any(r => r.CoopId == closestRecord.CoopId);
            if (isCloserToDifferent)
            {
                foreach (var record in trackingRecords)
                {
                    record.TokenSpendWithoutExiting = false;
                }
                _ = SaveTrackingRecords();
            }
        }
    }

    private async Task RefreshLocation()
    {
        try
        {
            var coords = await JSRuntime.InvokeAsync<CoordinateDto>("coopMap.getUserCoordinates");
            if (coords != null)
            {
                userLat = coords.Latitude;
                userLng = coords.Longitude;
                EvaluateDistances();
                EvaluateGeofence(userLat.Value, userLng.Value);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error retrieving coordinates: {ex.Message}");
            userLat = null;
            userLng = null;
            isCloserToOpposite = false; // Default to warning if we cannot check coordinates
        }
        StateHasChanged();
    }

    private void EvaluateDistances()
    {
        if (!userLat.HasValue || !userLng.HasValue || userCoop == null || otherCoop == null)
        {
            isCloserToOpposite = false;
            return;
        }

        var hasUserCoopCoord = userCoop.CenterCoordinate != null && Microsoft.FSharp.Core.OptionModule.IsSome(userCoop.CenterCoordinate);
        var hasOtherCoopCoord = otherCoop.CenterCoordinate != null && Microsoft.FSharp.Core.OptionModule.IsSome(otherCoop.CenterCoordinate);

        if (!hasUserCoopCoord || !hasOtherCoopCoord)
        {
            isCloserToOpposite = false;
            return;
        }

        var userCoopCoord = userCoop.CenterCoordinate!.Value;
        var otherCoopCoord = otherCoop!.CenterCoordinate!.Value;

        var distToOwn = CalculateDistance(userLat.Value, userLng.Value, userCoopCoord.Latitude, userCoopCoord.Longitude);
        var distToOther = CalculateDistance(userLat.Value, userLng.Value, otherCoopCoord.Latitude, otherCoopCoord.Longitude);

        // Supposed to spend the token in the opposite cooperative's territory (loading passengers there)
        isCloserToOpposite = distToOther < distToOwn;
    }

    private double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        var R = 6371000.0; // Earth's radius in meters
        var phi1 = lat1 * Math.PI / 180.0;
        var phi2 = lat2 * Math.PI / 180.0;
        var deltaPhi = (lat2 - lat1) * Math.PI / 180.0;
        var deltaLambda = (lon2 - lon1) * Math.PI / 180.0;

        var a = Math.Sin(deltaPhi / 2.0) * Math.Sin(deltaPhi / 2.0) +
                Math.Cos(phi1) * Math.Cos(phi2) *
                Math.Sin(deltaLambda / 2.0) * Math.Sin(deltaLambda / 2.0);
        
        var c = 2.0 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1.0 - a));
        return R * c;
    }

    private async Task ExecuteSpend(bool skipWarning = false)
    {
        errorMessage = null;
        successMessage = null;

        if (userContext == null || userCoop == null || targetLedger == null) return;

        if (!skipWarning && !isCloserToOpposite)
        {
            var warningText = Loc["GeolocationOverrideWarning"].Value;
            var confirmOverride = await JSRuntime.InvokeAsync<bool>("confirm", warningText);
            if (!confirmOverride) return;
        }

        isLoading = true;
        try
        {
            var result = await LedgerService.SpendToken(userContext, targetLedger.LedgerId, userCoop.CoopId, currentUserId, CancellationToken.None);
            if (result.IsOk)
            {
                successMessage = Loc["TokenSpentRegisteredSuccessfully"];

                // Set tokenSpendWithoutExiting to true for the closest cooperative
                if (userLat.HasValue && userLng.HasValue && trackingRecords.Any())
                {
                    CoopTrackingRecord? closestRecord = null;
                    double minDistance = double.MaxValue;
                    foreach (var record in trackingRecords)
                    {
                        double dist = CalculateDistance(userLat.Value, userLng.Value, record.Latitude, record.Longitude);
                        if (dist < minDistance)
                        {
                            minDistance = dist;
                            closestRecord = record;
                        }
                    }
                    if (closestRecord != null)
                    {
                        closestRecord.TokenSpendWithoutExiting = true;
                        await SaveTrackingRecords();
                    }
                }

                await LoadDashboard();
            }
            else
            {
                errorMessage = $"{Loc["FailedToSpendTokenPrefix"]}{result.ErrorValue}";
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{Loc["ErrorOccurredSpendingTokenPrefix"]}{ex.Message}";
            isLoading = false;
        }
    }

    public class CoordinateDto
    {
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }
}

