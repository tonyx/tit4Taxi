## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Te]mp/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/
# Generated user secrets file
usrsecrets.json

# Web/App Host databases
*.db
*.sqlite

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, since it is used to store build-time dependencies
!**/[Pp]ackages/build/
# If using NuGet legacy packages.config, uncomment the next line
# !packages.config

# Directory Build Projects cached/generated files
# Directory.Build.rsp

# dotnet-tools.json - local tools manifest
# .config/dotnet-tools.json

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# User-specific developer files
.env
.env.*
!.env.example
