@page "/Admin/Ledgers"
@attribute [Authorize(Roles = "ADMIN")]
@using TitForTat.Services
@using TitForTat.Shared.Services
@using static TitForTat.Shared.Commons
@using static TitForTat.Domain.Coop
@using static TitForTat.Domain.Ledger
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TitForTat.Shared
@inject ILedgerService LedgerService
@inject ICoopService CoopService
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<PageTitle>@Loc["ManageLedgers"]</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-12">
            <div class="card border-0 shadow-lg" style="border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                <div class="card-header bg-gradient bg-primary text-white d-flex justify-content-between align-items-center py-4" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-20 p-2 rounded-3">
                            <i class="bi bi-journal-text fs-4 text-white"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-bold">@Loc["LedgerManagement"]</h3>
                            <p class="mb-0 text-white-50 small">@Loc["ViewAndManageCooperativeLedgersAndFlows"]</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                            <i class="bi bi-exclamation-octagon-fill me-2"></i>
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @successMessage
                            <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Create Ledger Form -->
                    <div class="p-4 mb-5 border rounded-4 bg-light bg-opacity-50 shadow-sm">
                        <h4 class="mb-3 fw-bold text-dark fs-5"><i class="bi bi-plus-circle-fill me-2 text-primary"></i>@Loc["CreateNewLedger"]</h4>
                        <EditForm Model="@newLedgerModel" OnValidSubmit="HandleCreateLedger">
                            <DataAnnotationsValidator />
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="coop1" class="form-label fw-semibold text-secondary">@Loc["Cooperative1"]</label>
                                    <select id="coop1" class="form-select form-select-lg bg-white shadow-sm" style="border-radius: 10px;" @bind="newLedgerModel.Coop1IdString">
                                        <option value="">@Loc["SelectCooperative1Option"]</option>
                                        @if (coops != null)
                                        {
                                            @foreach (var coop in coops)
                                            {
                                                <option value="@coop.CoopId.Value">@coop.Name</option>
                                            }
                                        }
                                    </select>
                                    <ValidationMessage For="() => newLedgerModel.Coop1IdString" class="text-danger mt-1 small" />
                                </div>

                                <div class="col-md-6">
                                    <label for="coop2" class="form-label fw-semibold text-secondary">@Loc["Cooperative2"]</label>
                                    <select id="coop2" class="form-select form-select-lg bg-white shadow-sm" style="border-radius: 10px;" @bind="newLedgerModel.Coop2IdString">
                                        <option value="">@Loc["SelectCooperative2Option"]</option>
                                        @if (coops != null)
                                        {
                                            @foreach (var coop in coops)
                                            {
                                                <option value="@coop.CoopId.Value">@coop.Name</option>
                                            }
                                        }
                                    </select>
                                    <ValidationMessage For="() => newLedgerModel.Coop2IdString" class="text-danger mt-1 small" />
                                </div>

                                <div class="col-md-6">
                                    <label for="flow1" class="form-label fw-semibold text-secondary d-flex justify-content-between align-items-center">
                                        <span>@Loc["EstimatedValue"]</span>
                                        <button type="button" class="btn btn-link p-0 text-decoration-none text-secondary small" @onclick="ToggleHelp" style="font-size: 0.8rem;">
                                            <i class="bi bi-question-circle"></i> @Loc["WhatIsThis"]
                                        </button>
                                    </label>
                                    <InputNumber id="flow1" class="form-control form-control-lg bg-white shadow-sm" style="border-radius: 10px;" placeholder="e.g. 2.0" @bind-Value="newLedgerModel.Flow1" />
                                    <ValidationMessage For="() => newLedgerModel.Flow1" class="text-danger mt-1 small" />
                                </div>

                                <div class="col-md-6">
                                    <label for="flow2" class="form-label fw-semibold text-secondary d-flex justify-content-between align-items-center">
                                        <span>@Loc["EstimatedValue"]</span>
                                        <button type="button" class="btn btn-link p-0 text-decoration-none text-secondary small" @onclick="ToggleHelp" style="font-size: 0.8rem;">
                                            <i class="bi bi-question-circle"></i> @Loc["WhatIsThis"]
                                        </button>
                                    </label>
                                    <InputNumber id="flow2" class="form-control form-control-lg bg-white shadow-sm" style="border-radius: 10px;" placeholder="e.g. 1.0" @bind-Value="newLedgerModel.Flow2" />
                                    <ValidationMessage For="() => newLedgerModel.Flow2" class="text-danger mt-1 small" />
                                </div>

                                @if (showHelp)
                                {
                                    <div class="col-12 mt-2">
                                        <div class="alert alert-info border-0 shadow-sm d-flex gap-3 mb-2 align-items-start" style="border-radius: 12px; background: rgba(13, 202, 240, 0.1); border-left: 4px solid #0dcaf0 !important;">
                                            <i class="bi bi-info-circle-fill text-info fs-5 mt-1"></i>
                                            <div class="flex-grow-1">
                                                <h6 class="fw-bold text-dark mb-1">@Loc["UnderstandingEstimatedValue"]</h6>
                                                <p class="mb-0 text-secondary small">
                                                    @Loc["EstimatedValueHelpText"]
                                                </p>
                                            </div>
                                            <button type="button" class="btn-close ms-2" @onclick="ToggleHelp" aria-label="Close"></button>
                                        </div>
                                    </div>
                                }

                                <div class="col-12 mt-4 text-end">
                                    <button type="submit" class="btn btn-primary btn-lg shadow px-5" style="border-radius: 10px; font-weight: 600;">
                                        <i class="bi bi-plus-lg me-2"></i>@Loc["CreateLedger"]
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>

                    <!-- Existing Ledgers Section -->
                    <h4 class="mb-3 fw-bold text-dark fs-5"><i class="bi bi-list-stars me-2 text-primary"></i>@Loc["ActiveLedgers"]</h4>
                    @if (ledgers == null || coops == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Loc["Loading"]</span>
                            </div>
                            <p class="mt-2 text-muted">@Loc["RetrievingData"]</p>
                        </div>
                    }
                    else if (!ledgers.Any())
                    {
                        <div class="text-center py-5 border border-dashed rounded-4 bg-white shadow-sm">
                            <i class="bi bi-folder-x fs-1 text-muted"></i>
                            <p class="mt-3 mb-0 text-secondary fw-semibold">@Loc["NoLedgersCreatedYet"]</p>
                            <p class="text-muted small">@Loc["SelectCoopsToCreateLedger"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive shadow-sm rounded-4">
                            <table class="table table-hover align-middle mb-0 bg-white">
                                <thead class="table-dark">
                                    <tr>
                                        <th class="ps-4">@Loc["LedgerId"]</th>
                                        <th>@Loc["Cooperative1"]</th>
                                        <th>@Loc["Cooperative2"]</th>
                                        <th class="text-center">@Loc["Flow1To2"]</th>
                                        <th class="text-center">@Loc["Flow2To1"]</th>
                                        <th class="text-center">@Loc["ExchangeRate1To2"]</th>
                                        <th class="text-center">@Loc["ExchangeRate2To1"]</th>
                                        <th class="text-center">@Loc["TokensSpentCoop1"]</th>
                                        <th class="text-center">@Loc["TokensSpentCoop2"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ledger in ledgers)
                                    {
                                        <tr>
                                            <td class="ps-4 font-monospace small">
                                                <a href="/Ledger/@ledger.LedgerId.Value" class="text-primary fw-bold text-decoration-none" title="View Ledger Details: @ledger.LedgerId.Value">
                                                    @ledger.LedgerId.Value.ToString()[..8]...
                                                </a>
                                            </td>
                                            <td class="fw-bold text-dark">
                                                @GetCoopName(ledger.Coops.Item1)
                                            </td>
                                            <td class="fw-bold text-dark">
                                                @GetCoopName(ledger.Coops.Item2)
                                            </td>
                                            <td class="text-center text-primary fw-semibold">
                                                @ledger.Coop1MarketValue.ToString("N2")
                                            </td>
                                            <td class="text-center text-primary fw-semibold">
                                                @ledger.Coop2MarketValue.ToString("N2")
                                            </td>
                                            <td class="text-center text-secondary small">
                                                @ledger.ExchangeRateAppliedToCoop1().ToString("N4")
                                            </td>
                                            <td class="text-center text-secondary small">
                                                @ledger.ExchangeRateAppliedToCoop2().ToString("N4")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                    @ledger.TokenSpentByCoop1.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                    @ledger.TokenSpentByCoop2.ToString("N2")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Coop>? coops;
    private List<Ledger>? ledgers;
    private string? errorMessage;
    private string? successMessage;
    private LedgerFormModel newLedgerModel = new();
    private UserContext? userContext;
    private bool showHelp = true;

    private void ToggleHelp()
    {
        showHelp = !showHelp;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userContext = ConverterUtils.fromClaimsPrincipal(authState.User);
        await LoadData();
    }

    private async Task LoadData()
    {
        if (userContext == null) return;

        var coopsResult = await CoopService.GetAllCoops(userContext, CancellationToken.None);
        if (coopsResult.IsOk)
        {
            coops = coopsResult.ResultValue.ToList();
        }
        else
        {
            errorMessage = Loc["FailedToLoadCooperativesPrefix"] + coopsResult.ErrorValue;
        }

        var ledgersResult = await LedgerService.GetActiveLedgers(userContext, CancellationToken.None);
        if (ledgersResult.IsOk)
        {
            ledgers = ledgersResult.ResultValue.ToList();
        }
        else
        {
            errorMessage = Loc["FailedToLoadLedgersPrefix"] + ledgersResult.ErrorValue;
        }
    }

    private string GetCoopName(CoopId coopId)
    {
        if (coops == null) return coopId.Value.ToString();
        var coop = coops.FirstOrDefault(c => c.CoopId.Value == coopId.Value);
        return coop != null ? coop.Name : coopId.Value.ToString();
    }

    private async Task HandleCreateLedger()
    {
        errorMessage = null;
        successMessage = null;

        if (userContext == null)
        {
            errorMessage = Loc["UserNotAuthenticated"];
            return;
        }

        if (string.IsNullOrEmpty(newLedgerModel.Coop1IdString) || string.IsNullOrEmpty(newLedgerModel.Coop2IdString))
        {
            errorMessage = Loc["PleaseSelectBothCooperatives"];
            return;
        }

        if (newLedgerModel.Coop1IdString == newLedgerModel.Coop2IdString)
        {
            errorMessage = Loc["CooperativesMustBeDifferent"];
            return;
        }

        if (!Guid.TryParse(newLedgerModel.Coop1IdString, out var coop1Guid) ||
            !Guid.TryParse(newLedgerModel.Coop2IdString, out var coop2Guid))
        {
            errorMessage = Loc["InvalidCooperativeSelected"];
            return;
        }

        if (newLedgerModel.Flow1 <= 0 || newLedgerModel.Flow2 <= 0)
        {
            errorMessage = Loc["FlowEstimatesPositive"];
            return;
        }

        // Check if ledger already exists in either direction
        if (ledgers != null)
        {
            var alreadyExists = ledgers.Any(l =>
                (l.Coops.Item1.Value == coop1Guid && l.Coops.Item2.Value == coop2Guid) ||
                (l.Coops.Item1.Value == coop2Guid && l.Coops.Item2.Value == coop1Guid)
            );

            if (alreadyExists)
            {
                errorMessage = Loc["LedgerAlreadyExists"];
                return;
            }
        }

        var coop1Id = CoopId.NewCoopId(coop1Guid);
        var coop2Id = CoopId.NewCoopId(coop2Guid);

        var result = await LedgerService.CreateLedger(
            userContext, 
            coop1Id, 
            coop2Id, 
            newLedgerModel.Flow1, 
            newLedgerModel.Flow2, 
            CancellationToken.None
        );

        if (result.IsOk)
        {
            successMessage = Loc["LedgerCreatedSuccessfully"];
            newLedgerModel = new LedgerFormModel();
            await LoadData();
        }
        else
        {
            errorMessage = Loc["FailedToCreateLedgerPrefix"] + result.ErrorValue;
        }
    }

    public class LedgerFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessageResourceType = typeof(TitForTat.Shared.SharedResources), ErrorMessageResourceName = "Cooperative1Required")]
        public string Coop1IdString { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessageResourceType = typeof(TitForTat.Shared.SharedResources), ErrorMessageResourceName = "Cooperative2Required")]
        public string Coop2IdString { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessageResourceType = typeof(TitForTat.Shared.SharedResources), ErrorMessageResourceName = "ValueRequired")]
        [System.ComponentModel.DataAnnotations.Range(0.0001, double.MaxValue, ErrorMessageResourceType = typeof(TitForTat.Shared.SharedResources), ErrorMessageResourceName = "ValueMustBeGreaterThanZero")]
        public double Flow1 { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessageResourceType = typeof(TitForTat.Shared.SharedResources), ErrorMessageResourceName = "ValueRequired")]
        [System.ComponentModel.DataAnnotations.Range(0.0001, double.MaxValue, ErrorMessageResourceType = typeof(TitForTat.Shared.SharedResources), ErrorMessageResourceName = "ValueMustBeGreaterThanZero")]
        public double Flow2 { get; set; }
    }
}
