@page "/Admin/RegistrationCodes"
@attribute [Authorize(Roles = "ADMIN, MANAGER")]
@using TitForTat.Services
@using Microsoft.AspNetCore.Authorization
@inject IRegistrationCodeService RegistrationCodeService
@rendermode InteractiveServer

<PageTitle>@Loc["RegistrationPinCodesTitle"]</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h3 class="mb-0 fs-5">@Loc["RegistrationPinCodesTitle"]</h3>
                    <button class="btn btn-light btn-sm" @onclick="GenerateCode">@Loc["GenerateCode"]</button>
                </div>
                <div class="card-body">
                    @if (generatedPin != null)
                    {
                        <div class="alert alert-success text-center mb-4" role="alert">
                            <h4 class="alert-heading">@Loc["NewPinGenerated"]</h4>
                            <p class="display-4 fw-bold my-2 text-monospace">@generatedPin</p>
                            <p class="mb-0 text-muted">@Loc["PinValidityMessage"]</p>
                        </div>
                    }

                    <h5 class="card-title mt-3 mb-3">@Loc["ActiveRegistrationPins"]</h5>
                    
                    @{
                        var activeCodes = RegistrationCodeService.GetActiveCodes().ToList();
                    }

                    @if (!activeCodes.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-0">@Loc["NoActivePinsMessage"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Loc["PinCode"]</th>
                                        <th>@Loc["ExpiresAtUtc"]</th>
                                        <th>@Loc["TimeRemaining"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (code, expiry) in activeCodes)
                                    {
                                        var timeRemaining = expiry - DateTime.UtcNow;
                                        var remainingStr = timeRemaining.Ticks > 0 
                                            ? string.Format(Loc["TimeRemainingFormat"].Value, (int)timeRemaining.TotalMinutes, timeRemaining.Seconds) 
                                            : Loc["Expired"].Value;
                                        <tr>
                                            <td class="font-monospace fw-bold fs-5">@(code)</td>
                                            <td>@expiry.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td class="@(timeRemaining.TotalMinutes < 2 ? "text-danger fw-bold" : "text-success")">
                                                @remainingStr
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string? generatedPin;

    private void GenerateCode()
    {
        generatedPin = RegistrationCodeService.GenerateCode();
    }
}
