@page "/Error"
@using System.Diagnostics

<PageTitle>@Loc["ErrorTitle"]</PageTitle>

<h1 class="text-danger">@Loc["ErrorHeader"]</h1>
<h2 class="text-danger">@Loc["ErrorSubheader"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Loc["RequestIdLabel"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Loc["DevelopmentModeHeader"]</h3>
<p>
    @((MarkupString)string.Format(Loc["DevelopmentModeDesc1"].Value, "<strong>Development</strong>"))
</p>
<p>
    @((MarkupString)string.Format(Loc["DevelopmentModeDesc2"].Value, "<strong>The Development environment shouldn't be enabled for deployed applications.</strong>", "<strong>Development</strong>", "<strong>ASPNETCORE_ENVIRONMENT</strong>", "<strong>Development</strong>"))
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
