@page "/counter"
@rendermode InteractiveAuto

<PageTitle>@Loc["CounterTitle"]</PageTitle>

<h1>@Loc["CounterTitle"]</h1>

<p role="status">@string.Format(Loc["CurrentCountFormat"], currentCount)</p>

<button class="btn btn-primary" @onclick="IncrementCount">@Loc["ClickMe"]</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
