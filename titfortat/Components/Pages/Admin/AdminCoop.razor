@page "/Admin/Coop/{CoopIdString}"
@using TitForTat.Services
@using TitForTat.Shared.Services
@using static TitForTat.Shared.Commons
@using static TitForTat.Domain.Coop
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TitForTat.Shared
@using static TitForTat.Domain.User
@inject ICoopService CoopService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Cooperative Details</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-10 offset-lg-1">
            <div class="mb-4">
                <a href="/Admin/Coops" class="btn btn-outline-secondary btn-sm shadow-sm" style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-2"></i>Back to Cooperatives
                </a>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Retrieving cooperative details...</p>
                </div>
            }
            else if (!isAuthorized)
            {
                <div class="card border-0 shadow-lg text-center p-5" style="border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                    <div class="text-danger mb-3">
                        <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Access Denied</h3>
                    <p class="text-muted">You do not have permission to access this cooperative's management page. Only administrators and cooperative managers are permitted.</p>
                </div>
            }
            else if (coop == null)
            {
                <div class="card border-0 shadow-lg text-center p-5" style="border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                    <div class="text-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Cooperative Not Found</h3>
                    <p class="text-muted">The requested cooperative does not exist or has been removed.</p>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-lg mb-5" style="border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                    <div class="card-header bg-gradient bg-primary text-white d-flex justify-content-between align-items-center py-4" style="border-top-left-radius: 16px; border-top-right-radius: 16px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-white bg-opacity-20 p-2 rounded-3">
                                <i class="bi bi-building fs-4 text-white"></i>
                            </div>
                            <div>
                                <h3 class="mb-0 fw-bold">@coop.Name</h3>
                                <p class="mb-0 text-white-50 small">Cooperative ID: <span class="font-monospace text-white">@coop.CoopId.Value</span></p>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                                <i class="bi bi-exclamation-octagon-fill me-2"></i>
                                @errorMessage
                                <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                @successMessage
                                <button type="button" class="btn-close" @onclick="() => successMessage = null" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Coop Location Section -->
                        <div class="card border-0 shadow-sm mb-5" style="border-radius: 12px; background: #f8f9fa;">
                            <div class="card-body p-4">
                                <h4 class="fw-bold text-dark fs-5 mb-3">
                                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>Cooperative Center Location
                                </h4>
                                <p class="text-muted small">
                                    Set the central coordinates for this cooperative. You can use the map to click or drag the marker, or retrieve your current browser location.
                                </p>
                                
                                <div class="row g-3 mb-4">
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold text-secondary small">Latitude</label>
                                        <input type="number" step="any" class="form-control" placeholder="Not set" @bind="latitude" style="border-radius: 8px;" />
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold text-secondary small">Longitude</label>
                                        <input type="number" step="any" class="form-control" placeholder="Not set" @bind="longitude" style="border-radius: 8px;" />
                                    </div>
                                    <div class="col-md-2 d-flex align-items-end">
                                        <button class="btn btn-outline-primary w-100 shadow-sm" style="border-radius: 8px; height: 38px;" @onclick="LocateUser">
                                            <i class="bi bi-cursor-fill me-1"></i>Locate
                                        </button>
                                    </div>
                                </div>

                                <div class="mb-4" style="border-radius: 12px; overflow: hidden; border: 1px solid #dee2e6;">
                                    <div id="coop-map" style="height: 300px; width: 100%;"></div>
                                </div>

                                <div class="text-end">
                                    <button class="btn btn-primary px-4 shadow-sm" style="border-radius: 8px;" @onclick="SaveLocation" disabled="@isSavingLocation">
                                        @if (isSavingLocation)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                            <span>Saving...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-save2-fill me-1"></i><span>Save Location</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Coop Members Section -->
                        <div class="mb-5">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4 class="fw-bold text-dark fs-5 mb-0">Cooperative Members & Managers</h4>
                                <span class="badge bg-primary rounded-pill px-3 py-2">@(coopUsers?.Count ?? 0) Total</span>
                            </div>

                            @if (coopUsers == null)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border text-primary spinner-border-sm" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            }
                            else if (!coopUsers.Any())
                            {
                                <div class="text-center py-4 border border-dashed rounded-4 bg-light bg-opacity-50">
                                    <i class="bi bi-person-x fs-2 text-muted"></i>
                                    <p class="mt-2 mb-0 text-secondary fw-semibold">No members in this cooperative yet.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive shadow-sm rounded-4">
                                    <table class="table table-hover align-middle mb-0 bg-white">
                                        <thead class="table-dark">
                                            <tr>
                                                <th class="ps-4">User ID</th>
                                                <th>Username</th>
                                                <th>Email</th>
                                                <th>Coop Role</th>
                                                <th class="pe-4 text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in coopUsers)
                                            {
                                                var isUserManager = coop.IsManager(user.UserId);
                                                <tr>
                                                    <td class="ps-4 font-monospace small text-muted">@user.UserId.Value</td>
                                                    <td class="fw-bold text-dark">@user.AppUserInfo.UserName</td>
                                                    <td>@user.AppUserInfo.Email</td>
                                                    <td>
                                                        @if (isUserManager)
                                                        {
                                                            <span class="badge bg-danger rounded-pill px-3 py-1.5"><i class="bi bi-shield-fill me-1"></i>Manager</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-info text-dark rounded-pill px-3 py-1.5">Member</span>
                                                        }
                                                    </td>
                                                    <td class="pe-4 text-end">
                                                        @if (isUserManager)
                                                        {
                                                            <button class="btn btn-sm btn-outline-warning px-3 shadow-sm" style="border-radius: 8px;" @onclick="() => DemoteUser(user)">
                                                                <i class="bi bi-shield-slash-fill me-1"></i>Demote
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-success px-3 shadow-sm" style="border-radius: 8px;" @onclick="() => PromoteUser(user)">
                                                                <i class="bi bi-shield-fill me-1"></i>Promote
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <!-- Unaffiliated Users Section -->
                        <div>
                            <h4 class="mb-3 fw-bold text-dark fs-5">Add Members (Unaffiliated Users)</h4>
                            @if (availableUsers == null)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border text-primary spinner-border-sm" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </div>
                            }
                            else if (!availableUsers.Any())
                            {
                                <div class="text-center py-4 border border-dashed rounded-4 bg-light bg-opacity-50">
                                    <i class="bi bi-check-all fs-2 text-success"></i>
                                    <p class="mt-2 mb-0 text-secondary fw-semibold">All registered users are already assigned to cooperatives.</p>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive shadow-sm rounded-4">
                                    <table class="table table-hover align-middle mb-0 bg-white">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th class="ps-4">User ID</th>
                                                <th>Username</th>
                                                <th>Email</th>
                                                <th class="pe-4 text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in availableUsers)
                                            {
                                                <tr>
                                                    <td class="ps-4 font-monospace small text-muted">@user.UserId.Value</td>
                                                    <td class="fw-semibold text-dark">@user.AppUserInfo.UserName</td>
                                                    <td>@user.AppUserInfo.Email</td>
                                                    <td class="pe-4 text-end">
                                                        <button class="btn btn-sm btn-success px-3 shadow-sm" style="border-radius: 8px;" @onclick="() => AddUserToCoop(user)">
                                                            <i class="bi bi-person-plus-fill me-1"></i>Add to Coop
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string CoopIdString { get; set; } = string.Empty;

    private Coop? coop;
    private List<User>? coopUsers;
    private List<User>? availableUsers;
    private bool isAuthorized = false;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;
    private UserContext? userContext;

    private double? latitude;
    private double? longitude;
    private bool isSavingLocation = false;
    private bool mapInitialized = false;
    private DotNetObjectReference<AdminCoop>? dotNetHelper;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            userContext = ConverterUtils.fromClaimsPrincipal(authState.User);

            if (userContext == null || userContext.IsAnonymous)
            {
                isAuthorized = false;
                isLoading = false;
                return;
            }

            if (!Guid.TryParse(CoopIdString, out var coopGuid))
            {
                errorMessage = "Invalid Cooperative ID format.";
                isLoading = false;
                return;
            }

            var coopId = CoopId.NewCoopId(coopGuid);
            var coopResult = await CoopService.GetCoop(userContext, coopId, CancellationToken.None);

            if (!coopResult.IsOk)
            {
                errorMessage = $"Failed to load cooperative: {coopResult.ErrorValue}";
                isLoading = false;
                return;
            }

            coop = coopResult.ResultValue;

            if (coop.CenterCoordinate != null && Microsoft.FSharp.Core.OptionModule.IsSome(coop.CenterCoordinate))
            {
                var coord = coop.CenterCoordinate.Value;
                latitude = coord.Latitude;
                longitude = coord.Longitude;
            }
            else
            {
                latitude = null;
                longitude = null;
            }

            // Check authorization
            var isAdmin = authState.User.IsInRole("ADMIN");
            
            UserId? currentUserId = null;
            if (userContext is UserContext.Authenticated authenticated)
            {
                currentUserId = authenticated.UserId;
            }

            var isManager = currentUserId != null && coop.IsManager(currentUserId);

            if (!isAdmin && !isManager)
            {
                isAuthorized = false;
                isLoading = false;
                return;
            }

            isAuthorized = true;

            // Load users directories
            var allUsersResult = await UserService.GetAllUsers(userContext, CancellationToken.None);
            var allCoopsResult = await CoopService.GetAllCoops(userContext, CancellationToken.None);

            if (allUsersResult.IsOk && allCoopsResult.IsOk)
            {
                var allUsers = allUsersResult.ResultValue;
                var allCoops = allCoopsResult.ResultValue;

                // Identify all users that are members or managers of any cooperative
                var allCoopUserIds = allCoops
                    .SelectMany(c => c.Members.Concat(c.Managers).Select(m => m.Value))
                    .ToHashSet();

                // Unaffiliated users (not in any coop)
                availableUsers = allUsers
                    .Where(u => !allCoopUserIds.Contains(u.UserId.Value))
                    .ToList();

                // Members of this coop (managers and members)
                var currentCoopUserIds = coop.Members.Concat(coop.Managers).Select(m => m.Value).ToHashSet();
                coopUsers = allUsers
                    .Where(u => currentCoopUserIds.Contains(u.UserId.Value))
                    .ToList();
            }
            else
            {
                errorMessage = "Failed to load user directories.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddUserToCoop(User user)
    {
        if (userContext == null || coop == null) return;

        errorMessage = null;
        successMessage = null;

        var result = await CoopService.AddMember(userContext, coop.CoopId, user.UserId, CancellationToken.None);
        if (result.IsOk)
        {
            successMessage = $"Successfully added {user.AppUserInfo.UserName} to {coop.Name}.";
            await LoadData();
        }
        else
        {
            errorMessage = $"Failed to add member: {result.ErrorValue}";
        }
    }

    private async Task PromoteUser(User user)
    {
        if (userContext == null || coop == null) return;

        errorMessage = null;
        successMessage = null;

        var result = await CoopService.PromoteMember(userContext, coop.CoopId, user.UserId, CancellationToken.None);
        if (result.IsOk)
        {
            successMessage = $"Successfully promoted {user.AppUserInfo.UserName} to Manager.";
            await LoadData();
        }
        else
        {
            errorMessage = $"Failed to promote user: {result.ErrorValue}";
        }
    }

    private async Task DemoteUser(User user)
    {
        if (userContext == null || coop == null) return;

        errorMessage = null;
        successMessage = null;

        var result = await CoopService.DemoteMember(userContext, coop.CoopId, user.UserId, CancellationToken.None);
        if (result.IsOk)
        {
            successMessage = $"Successfully demoted {user.AppUserInfo.UserName} to Member.";
            await LoadData();
        }
        else
        {
            errorMessage = $"Failed to demote user: {result.ErrorValue}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetHelper = DotNetObjectReference.Create(this);
        }

        if (isAuthorized && coop != null && !mapInitialized && dotNetHelper != null)
        {
            mapInitialized = true;
            try
            {
                await JSRuntime.InvokeVoidAsync("coopMap.initialize", "coop-map", dotNetHelper, latitude, longitude);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing map: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public void UpdateCoordinatesFromMap(double lat, double lng)
    {
        latitude = lat;
        longitude = lng;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnLocationSuccess(double lat, double lng)
    {
        latitude = lat;
        longitude = lng;
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("coopMap.updateMarker", lat, lng);
    }

    [JSInvokable]
    public void OnLocationError(string message)
    {
        errorMessage = message;
        StateHasChanged();
    }

    private async Task LocateUser()
    {
        if (dotNetHelper != null)
        {
            errorMessage = null;
            await JSRuntime.InvokeVoidAsync("coopMap.getUserLocation", dotNetHelper);
        }
    }

    private async Task SaveLocation()
    {
        if (userContext == null || coop == null || !latitude.HasValue || !longitude.HasValue) return;

        isSavingLocation = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var coord = new Coordinate(latitude.Value, longitude.Value);
            var result = await CoopService.SetCenterCoordinate(userContext, coop.CoopId, coord, CancellationToken.None);
            if (result.IsOk)
            {
                successMessage = "Cooperative location updated successfully.";
                // Refresh/reload the coop state
                var coopResult = await CoopService.GetCoop(userContext, coop.CoopId, CancellationToken.None);
                if (coopResult.IsOk)
                {
                    coop = coopResult.ResultValue;
                }
            }
            else
            {
                errorMessage = $"Failed to save location: {result.ErrorValue}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while saving: {ex.Message}";
        }
        finally
        {
            isSavingLocation = false;
        }
    }

    public void Dispose()
    {
        dotNetHelper?.Dispose();
    }
}
