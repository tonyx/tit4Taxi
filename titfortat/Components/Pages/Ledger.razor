@page "/Ledger/{LedgerIdString}"
@attribute [Authorize]
@using TitForTat.Services
@using TitForTat.Shared.Services
@using static TitForTat.Shared.Commons
@using static TitForTat.Domain.Coop
@using static TitForTat.Domain.Ledger
@using static TitForTat.Domain.User
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TitForTat.Shared
@inject ILedgerService LedgerService
@inject ICoopService CoopService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<PageTitle>@Loc["LedgerDetails"]</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-12">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Loc["Loading"]</span>
                    </div>
                    <p class="mt-2 text-muted">@Loc["RetrievingLedgerDetails"]</p>
                </div>
            }
            else if (!isAuthorized)
            {
                <div class="card border-0 shadow-lg text-center p-5" style="border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                    <div class="text-danger mb-3">
                        <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-dark">@Loc["AccessDenied"]</h3>
                    <p class="text-muted">@Loc["AccessDeniedLedgerDescription"]</p>
                </div>
            }
            else if (ledger == null)
            {
                <div class="card border-0 shadow-lg text-center p-5" style="border-radius: 16px; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
                    <div class="text-warning mb-3">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
                    </div>
                    <h3 class="fw-bold text-dark">@Loc["LedgerNotFound"]</h3>
                    <p class="text-muted">@Loc["LedgerNotFoundDescription"]</p>
                </div>
            }
            else
            {
                <!-- Header Card -->
                <div class="card border-0 shadow-lg mb-4" style="border-radius: 16px; background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                    <div class="card-body p-4 text-white">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white bg-opacity-20 p-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center">
                                    <i class="bi bi-journal-text fs-3 text-white"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h3 class="mb-0 fw-bold">@Loc["LedgerDetails"]</h3>
                                        @if (ledger.LedgerStatus.IsActive)
                                        {
                                            <span class="badge bg-success px-2.5 py-1 rounded-pill small">@Loc["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2.5 py-1 rounded-pill small">@Loc["Archived"]</span>
                                        }
                                    </div>
                                    <p class="mb-0 text-white-50 small">@Loc["LedgerId"]: <span class="font-monospace text-white">@ledger.LedgerId.Value</span></p>
                                </div>
                             </div>
                             <div class="d-flex gap-2">
                                 <a class="btn btn-outline-light btn-sm shadow-sm px-4 py-2" href="/LedgerDetails/@LedgerIdString" style="border-radius: 10px; font-weight: 600;">
                                     <i class="bi bi-clock-history me-2"></i>Spending Analysis
                                 </a>
                                 @if (ledger.LedgerStatus.IsActive)
                                 {
                                     <button class="btn btn-warning btn-sm shadow-sm px-4 py-2" @onclick="ArchiveLedger" style="border-radius: 10px; font-weight: 600;">
                                         <i class="bi bi-archive-fill me-2"></i>@Loc["ArchiveLedger"]
                                     </button>
                                 }
                             </div>
                         </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius: 12px;">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i>
                        @errorMessage
                        <button type="button" class="btn-close" @onclick="() => errorMessage = null" aria-label="Close"></button>
                    </div>
                }

                <div class="row g-4">
                    <!-- Coop 1 Stats Card -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-left: 6px solid #ffc107;">
                            <div class="card-body p-4">
                                <span class="badge bg-warning text-dark mb-2 px-3 py-1.5 rounded-pill">@Loc["Cooperative1"]</span>
                                <h4 class="fw-bold text-dark mb-3">@(coop1?.Name ?? "Unknown Coop 1")</h4>
                                <hr />
                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <label class="text-secondary small fw-semibold">@Loc["EstimatedValue"]</label>
                                        <div class="fs-5 fw-bold text-dark">@ledger.Coop1MarketValue.ToString("N2")</div>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <label class="text-secondary small fw-semibold">@Loc["ExchangeRateOppositeTerritory"]</label>
                                        <div class="fs-5 fw-bold text-dark">@ledger.ExchangeRateAppliedToCoop1().ToString("N4")</div>
                                    </div>
                                    <div class="col-12">
                                        <label class="text-secondary small fw-semibold">@Loc["TotalSpentTokens"]</label>
                                        <div class="fs-4 fw-extrabold text-primary">@ledger.TokenSpentByCoop1.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Coop 2 Stats Card -->
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm h-100" style="border-radius: 16px; border-left: 6px solid #0dcaf0;">
                            <div class="card-body p-4">
                                <span class="badge bg-info text-dark mb-2 px-3 py-1.5 rounded-pill">@Loc["Cooperative2"]</span>
                                <h4 class="fw-bold text-dark mb-3">@(coop2?.Name ?? "Unknown Coop 2")</h4>
                                <hr />
                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <label class="text-secondary small fw-semibold">@Loc["EstimatedValue"]</label>
                                        <div class="fs-5 fw-bold text-dark">@ledger.Coop2MarketValue.ToString("N2")</div>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <label class="text-secondary small fw-semibold">@Loc["ExchangeRateOppositeTerritory"]</label>
                                        <div class="fs-5 fw-bold text-dark">@ledger.ExchangeRateAppliedToCoop2().ToString("N4")</div>
                                    </div>
                                    <div class="col-12">
                                        <label class="text-secondary small fw-semibold">@Loc["TotalSpentTokens"]</label>
                                        <div class="fs-4 fw-extrabold text-primary">@ledger.TokenSpentByCoop2.ToString("N2")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Per User Balance Table -->
                    <div class="col-12">
                        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-dark mb-4">
                                    <i class="bi bi-people-fill text-primary me-2"></i>@Loc["TokenBalancePerUser"]
                                </h5>

                                @if (ledger.PerUserBalance == null || !ledger.PerUserBalance.Any())
                                {
                                    <div class="text-center py-5 border border-dashed rounded-4 bg-light bg-opacity-50">
                                        <i class="bi bi-person-x fs-1 text-muted"></i>
                                        <p class="mt-3 mb-0 text-secondary fw-semibold">@Loc["NoUserBalancesRecorded"]</p>
                                        <p class="text-muted small">@Loc["BalancesAppearDescription"]</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive shadow-sm rounded-4">
                                        <table class="table table-hover align-middle mb-0 bg-white">
                                            <thead class="table-dark">
                                                <tr>
                                                    <th class="ps-4">@Loc["User"]</th>
                                                    <th>@Loc["Email"]</th>
                                                    <th class="text-center">@Loc["TokensSpentAsCoop1Member"]</th>
                                                    <th class="text-center">@Loc["TokensSpentAsCoop2Member"]</th>
                                                    <th class="text-center">@Loc["TotalTokensSpent"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var balance in ledger.PerUserBalance)
                                                {
                                                    var userObj = GetUser(balance.UserId);
                                                    <tr>
                                                        <td class="ps-4 fw-bold text-dark">
                                                            @(userObj?.AppUserInfo.UserName ?? balance.UserId.Value.ToString()[..8])
                                                        </td>
                                                        <td>
                                                            @(userObj?.AppUserInfo.Email ?? Loc["NotAvailable"].Value)
                                                        </td>
                                                        <td class="text-center fw-semibold text-warning">
                                                            @balance.TokenSpentCoop1.ToString("N2")
                                                        </td>
                                                        <td class="text-center fw-semibold text-info">
                                                            @balance.TokenSpentCoop2.ToString("N2")
                                                        </td>
                                                        <td class="text-center fw-bold text-primary">
                                                            @((balance.TokenSpentCoop1 + balance.TokenSpentCoop2).ToString("N2"))
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string LedgerIdString { get; set; } = string.Empty;

    private bool isLoading = true;
    private bool isAuthorized = false;
    private TitForTat.Domain.Ledger.Ledger? ledger;
    private Coop? coop1;
    private Coop? coop2;
    private List<User>? allUsers;
    private string? errorMessage;
    private UserContext? userContext;
    private UserId currentUserId = UserId.New();

    protected override async Task OnInitializedAsync()
    {
        await LoadLedgerDetails();
    }

    private async Task LoadLedgerDetails()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            userContext = ConverterUtils.fromClaimsPrincipal(authState.User);

            if (userContext == null || userContext.IsAnonymous)
            {
                isAuthorized = false;
                isLoading = false;
                return;
            }

            if (userContext is UserContext.Authenticated authenticated)
            {
                currentUserId = authenticated.UserId;
            }

            if (!Guid.TryParse(LedgerIdString, out var ledgerGuid))
            {
                errorMessage = Loc["InvalidLedgerIdFormat"];
                isLoading = false;
                return;
            }

            var ledgerId = LedgerId.NewLedgerId(ledgerGuid);
            var ledgerResult = await LedgerService.GetLedger(userContext, ledgerId, CancellationToken.None);

            if (!ledgerResult.IsOk)
            {
                errorMessage = $"{Loc["FailedToLoadLedgerPrefix"]}{ledgerResult.ErrorValue}";
                isLoading = false;
                return;
            }

            ledger = ledgerResult.ResultValue;

            // Fetch Coop 1 and Coop 2
            var coop1Result = await CoopService.GetCoop(userContext, ledger.Coops.Item1, CancellationToken.None);
            var coop2Result = await CoopService.GetCoop(userContext, ledger.Coops.Item2, CancellationToken.None);

            if (coop1Result.IsOk && coop2Result.IsOk)
            {
                coop1 = coop1Result.ResultValue;
                coop2 = coop2Result.ResultValue;
            }
            else
            {
                errorMessage = Loc["FailedToLoadParticipatingCooperatives"];
            }

            // Check authorization
            var isAdmin = authState.User.IsInRole("ADMIN");
            var isCoopMember = (coop1 != null && coop1.IsMember(currentUserId)) || 
                               (coop2 != null && coop2.IsMember(currentUserId));

            if (isAdmin || isCoopMember)
            {
                isAuthorized = true;
            }
            else
            {
                isAuthorized = false;
            }

            if (isAuthorized)
            {
                var usersResult = await UserService.GetAllUsers(userContext, CancellationToken.None);
                if (usersResult.IsOk)
                {
                    allUsers = usersResult.ResultValue.ToList();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{Loc["ErrorLoadingLedgerDetailsPrefix"]}{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private User? GetUser(UserId userId)
    {
        return allUsers?.FirstOrDefault(u => u.UserId.Value == userId.Value);
    }

    private async Task ArchiveLedger()
    {
        if (userContext == null || ledger == null) return;
        
        errorMessage = null;
        isLoading = true;
        try
        {
            var result = await LedgerService.ArchiveLedger(userContext, ledger.LedgerId, CancellationToken.None);
            if (result.IsOk)
            {
                await LoadLedgerDetails();
            }
            else
            {
                errorMessage = $"{Loc["FailedToArchiveLedgerPrefix"]}{result.ErrorValue}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"{Loc["ErrorOccurredPrefix"]}{ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
